# =============================================================================
#  FX-Reborn Toolkit Ultra 3.0 - .gitignore
#  EN: Files and folders Git must NOT upload to the repository.
#  PT: Arquivos e pastas que o Git NAO deve enviar para o repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Python cache / Cache do Python
# EN: Generated automatically when Python runs. Never commit.
# PT: Gerado automaticamente quando o Python roda. Nunca envie.
# -----------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -----------------------------------------------------------------------------
# Converter output / Saida do conversor
# EN: Files created when converting a game. NEVER publish game executables
#     (copyright + they are huge).
# PT: Arquivos criados ao converter um jogo. NUNCA publique executaveis de
#     jogos (direitos autorais + sao enormes).
# -----------------------------------------------------------------------------
*.f16c-backup
*.f16c-tmp
*.f16c-report.json
*_f16c.exe

# -----------------------------------------------------------------------------
# Engine / tests generated files / Gerados pelo motor e pelos testes
# EN: Rebuilt on every run - no need to version them.
# PT: Recriados a cada execucao - nao precisam ser versionados.
# -----------------------------------------------------------------------------
engine/staging/
engine/code_cache/
tests/selftest/bin/

# -----------------------------------------------------------------------------
# Packaged mods / Mods empacotados
# EN: Output of package_mod.py - share them as GitHub Releases, not in git.
# PT: Saida do package_mod.py - distribua pelo GitHub Releases, nao no git.
# -----------------------------------------------------------------------------
dist/
build/
mods_out/

# -----------------------------------------------------------------------------
# Binaries and archives / Binarios e arquivos compactados
# EN: Block every .exe / .zip, EXCEPT the portable Python bundled in python/
#     (users need it to run the tool without installing anything).
#     runtime/fxcompat.dll is intentionally versioned (prebuilt runtime).
# PT: Bloqueia todo .exe / .zip, EXCETO o Python portatil em python/
#     (o usuario precisa dele para rodar a ferramenta sem instalar nada).
#     runtime/fxcompat.dll e versionado de proposito (runtime pronto).
# -----------------------------------------------------------------------------
*.exe
!python/python.exe
!python/pythonw.exe
*.zip
!python/python313.zip
*.7z
*.rar

# -----------------------------------------------------------------------------
# Native build leftovers / Restos de compilacao nativa
# EN: Object files from building runtime/ or tests/ - rebuild locally.
# PT: Arquivos objeto ao compilar runtime/ ou tests/ - recompile local.
# -----------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb

# -----------------------------------------------------------------------------
# Logs and temp files / Logs e arquivos temporarios
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*~

# -----------------------------------------------------------------------------
# Local environments / Ambientes locais
# EN: Virtual envs and secrets stay on your machine.
# PT: Ambientes virtuais e segredos ficam so na sua maquina.
# -----------------------------------------------------------------------------
.venv/
venv/
env/
.env
.env.*

# -----------------------------------------------------------------------------
# Editors and OS / Editores e sistema operacional
# -----------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.swp
Thumbs.db
desktop.ini
.DS_Store
